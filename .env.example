# Bybit API Keys (Restrict to Read & Trade only, NO WITHDRAW)
BYBIT_API_KEY="your_bybit_api_key_here"
BYBIT_API_SECRET="your_bybit_api_secret_here"
BYBIT_TRADING_MODE="demo" # live or demo
BYBIT_TESTNET="False" # legacy fallback, only used if BYBIT_TRADING_MODE is unset

# Google Gemini API Key
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_DEFAULT_MODEL="gemini-2.5-flash"
GEMINI_TRIGGER_MODEL="gemini-2.5-pro" # optional, defaults to GEMINI_DEFAULT_MODEL when unset
GEMINI_MODEL="" # legacy single-model fallback, optional

# Database path (SQLite)
DB_PATH="data/gpt_trader.db"

# General Log Level
LOG_LEVEL="INFO"
LOG_FORMAT="text" # text or json
