# Bybit API Keys (Restrict to Read & Trade only, NO WITHDRAW)
BYBIT_API_KEY="your_bybit_api_key_here"
BYBIT_API_SECRET="your_bybit_api_secret_here"
BYBIT_TRADING_MODE="demo" # live or demo
BYBIT_TESTNET="False" # legacy fallback, only used if BYBIT_TRADING_MODE is unset

# Google Gemini API Key
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_DEFAULT_MODEL="gemini-2.5-pro"
GEMINI_TRIGGER_MODEL="gemini-2.5-pro" # optional, used for trigger/safety-context decisions when AI is invoked
GEMINI_MEMORY_MODEL="gemini-2.5-pro" # optional, defaults to trigger/default/legacy model order when unset
GEMINI_MODEL="" # legacy single-model fallback, optional

# Generic AI provider routing (preferred for multi-provider use)
AI_PROVIDER="gemini" # gemini, openai, deepseek, anthropic
AI_API_KEY="" # optional common key override; otherwise provider-specific key env is used
AI_BASE_URL="" # optional for OpenAI-compatible proxies or custom gateways
AI_DEFAULT_MODEL="" # optional generic default model override
AI_TRIGGER_MODEL="" # optional generic trigger/safety-context model override

# Provider-specific API keys for multi-provider use
OPENAI_API_KEY=""
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"
ANTHROPIC_API_KEY=""

# Memory batch provider overrides (optional)
MEMORY_PROVIDER=""
MEMORY_API_KEY=""
MEMORY_BASE_URL=""
MEMORY_MODEL=""

# Replay batch provider overrides (optional)
REPLAY_PROVIDER=""
REPLAY_API_KEY=""
REPLAY_BASE_URL=""
REPLAY_MODEL=""
REPLAY_WINDOW_HOURS="24"

# Database path (SQLite)
DB_PATH="data/gpt_trader.db"

# General Log Level
LOG_LEVEL="INFO"
LOG_FORMAT="text" # text or json

# Notes
# - Dashboard reads DB_PATH directly.
# - Bybit public orderbook WS uses supported linear depth 50 by default.
# - DeepSeek example:
#   AI_PROVIDER="deepseek"
#   AI_DEFAULT_MODEL="deepseek-reasoner"
#   AI_TRIGGER_MODEL="deepseek-reasoner" # or deepseek-chat for faster trigger calls
#   DEEPSEEK_API_KEY="your_deepseek_api_key_here"
